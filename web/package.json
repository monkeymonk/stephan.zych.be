{
  "name": "stephan.zych.be",
  "version": "1.12.1",
  "description": "",
  "scripts": {
    "dev": "concurrently \"npx @11ty/eleventy --serve\" \"node esbuild.config.mjs --watch\"",
    "build": "npx @11ty/eleventy && node esbuild.config.mjs",
    "check:cv": "node scripts/check-cv-parser.mjs && node scripts/check-cv-drift.mjs",
    "check:assets": "node scripts/check-content-assets.mjs",
    "check:keybindings": "node ../scripts/check-keybindings.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:styleguide": "node scripts/check-styleguide.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "verify:keys": "node scripts/verify-keys.mjs",
    "check:all": "npm run check:cv && npm run check:assets && npm run check:keybindings && npm run check:structure && npm run check:styleguide && npm run check:a11y && npm run verify:keys",
    "screenshot": "node screenshot.mjs",
    "audit": "node audit.mjs",
    "clean": "rm -rf _site dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "lit": "^3.3.2",
    "mermaid": "^11.15.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@axe-core/playwright": "^4.12.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.20.2",
    "gray-matter": "^4.0.3",
    "lighthouse": "^13.4.0",
    "playwright": "^1.49.0",
    "typescript": "^5.9.3"
  }
}
