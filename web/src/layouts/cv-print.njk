<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/styles/cv-print.css">
</head>
<body>
{{ content | safe }}
{# Behaviour lives in a file, not inline: the site's CSP is
   `script-src 'self' …` with no 'unsafe-inline', so an inline script here is
   blocked and the page silently never opens the print dialog. #}
<script src="/assets/cv-print.js"></script>
</body>
</html>
