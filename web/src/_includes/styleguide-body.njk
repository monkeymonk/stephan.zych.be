### Fenced Code Blocks

```typescript
interface Project {
  title: string;
  tags: string[];
}

class Notebook {
  private projects: Project[] = [];

  addProject(project: Project): void {
    this.projects.push(project);
  }

  filterByTag(tag: string): Project[] {
    return this.projects.filter((p) => p.tags.includes(tag));
  }
}
```

