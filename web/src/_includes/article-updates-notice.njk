{%- if updates | length %}
{%- set correctionCount = 0 %}
{%- set revisionCount = 0 %}
{%- for u in updates %}
{%- if u.kind == 'correction' %}
{%- set correctionCount = correctionCount + 1 %}
{%- else %}
{%- set revisionCount = revisionCount + 1 %}
{%- endif %}
{%- endfor %}
{%- if correctionCount and revisionCount %}
{%- set updateLabel = (correctionCount + revisionCount) ~ ' ' ~ (t('updates_unit_update', lang) if correctionCount + revisionCount == 1 else t('updates_unit_updates', lang)) %}
{%- elif correctionCount %}
{%- set updateLabel = correctionCount ~ ' ' ~ (t('updates_unit_correction', lang) if correctionCount == 1 else t('updates_unit_corrections', lang)) %}
{%- else %}
{%- set updateLabel = revisionCount ~ ' ' ~ (t('updates_unit_revision', lang) if revisionCount == 1 else t('updates_unit_revisions', lang)) %}
{%- endif %}
<a class="sz-updates-notice" href="#updates">
  <span class="sz-updates-notice__icon" aria-hidden="true">↻</span>
  {{ t('updates_notice_prefix', lang) }} <time datetime="{{ (updates | latestUpdate) | htmlDateString }}">{{ (updates | latestUpdate) | htmlDateString }}</time> · {{ updateLabel }}
</a>
{%- endif -%}
