---
layout: base.njk
title: Projects — Stéphan Zych
permalink: /projects/
section: { name: projects, path: /projects/ }
---
{% set allTags = collections.projects | collectTags %}
{# Same as the blog index: no visible page title by design, one sr-only h1, and
   it stays outside sz-portfolio so it is not slotted in as a grid item. #}
<h1 class="sr-only">Projects</h1>
<sz-portfolio filters="{{ allTags | join(',') }}" page-size="20">
  {% for project in collections.projects %}
    <a class="project-pane" href="{{ project.url }}" data-tags="{{ project.data.tags | join(',') }}">
      <h2 class="project-pane__title">{{ project.data.title }}</h2>
      <p class="project-pane__desc">{{ project.data.description }}</p>
      {% if project.data.tags %}
      <span class="project-pane__tags">
        {% for tag in project.data.tags %}<span class="project-pane__tag">{{ tag }}</span>{% endfor %}
      </span>
      {% endif %}
    </a>
  {% endfor %}
</sz-portfolio>
