---
layout: base.njk
title: "CV · Stéphan Zych"
description: "Full résumé of Stéphan Zych, hands-on lead developer and web architect with 15+ years across agency, founder, and consulting roles: application and web architecture, PHP and JavaScript/TypeScript, Docker and CI/CD delivery, developer experience, technical leadership, and AI-assisted engineering."
pagination:
  data: cvVariants
  size: 1
  alias: variant
permalink: "/cv/{% if variant.slug %}{{ variant.slug }}/{% endif %}"
---
{% set cv = variant.cv %}
{% set alumniOf = [] %}
{% for edu in cv.education %}
{% set alumniOf = (alumniOf.push({ "@type": "Organization", "name": edu.school }), alumniOf) %}
{% endfor %}

{% set knowsAbout = [] %}
{% for group in cv.skills %}
{% for item in group.items %}
{% set knowsAbout = (knowsAbout.push(item), knowsAbout) %}
{% endfor %}
{% endfor %}

{% set sameAs = [] %}
{% if cv.basics.linkedin %}{% set sameAs = (sameAs.push("https://" + cv.basics.linkedin), sameAs) %}{% endif %}
{% if cv.basics.github %}{% set sameAs = (sameAs.push("https://" + cv.basics.github), sameAs) %}{% endif %}

{% set jobTitle = variant.label or "Lead Developer" %}

{% set cvPerson = {
  "@type": "Person",
  "name": cv.basics.name,
  "jobTitle": jobTitle,
  "worksFor": { "@type": "Organization", "name": "CBTW" },
  "alumniOf": alumniOf,
  "knowsAbout": knowsAbout,
  "email": cv.basics.email,
  "address": { "@type": "PostalAddress", "addressLocality": "Brussels", "addressCountry": "BE" },
  "image": site.url + cv.basics.photo,
  "url": site.url + ((variant.slug and ("/cv/" + variant.slug + "/")) or "/cv/"),
  "sameAs": sameAs
} %}

{% set cvProfilePage = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": cvPerson
} %}

<script type="application/ld+json">{{ cvProfilePage | dump | safe }}</script>

{% include "cv-body.njk" %}
